<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="Test Package" Manufacturer="~Test" Version="0" Compressed="false" UpgradeCode="11111111-1111-1111-1111-111111111111">

        <Property Id="CHECK_PACKAGE_NAME" Value="$(var.New.Test.Package.PackageName)" />
        <Property Id="CHECK_PACKAGE_FILENAME" Value="$(var.New.Test.Package.PackageFileName)" />
        <Property Id="CHECK_PACKAGE_VERSION" Value="$(var.New.Test.Package.Version)" />
        <Property Id="CHECK_PACKAGE_TEST_FILE_PATH" Value="$(var.New.Test.Package.PackageDir)\test.txt" />

        <Feature Id="Main">
            <Component Directory="INSTALLFOLDER">
                <File Source="$(var.New.Test.Package.PackageDir)\test.txt" />
            </Component>
        </Feature>

    </Package>
</Wix>
